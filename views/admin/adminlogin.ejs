<section class="up">
  
  <h2 class="adminloginheading"> Sign In </h2>

  <article class="adminloginsection">
    
    <form class="loginform" action="/admin" method="POST">
      <div>
        <label for="username"> <b> Username </b> </label>
        <input type="text" name="username" class="loginusername" placeholder="Enter Username">
      </div>
    
      <div>
        <label for="password"> <b> Password </b></label>
        <input type="password" name="password" class="loginpassword" placeholder="Enter Password">
      </div>
    
      <div> <input type="submit" value="Login" class="loginbtn"> </div>
    </form>

  </article>
  
</section>


