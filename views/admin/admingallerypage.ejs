<section>
  
  <div class="goback"> <a href="/dashboard">&larr; Back</a> </div>
  
  <h1> Photos by AGO Kator </h1>
  
  <div class="galleryphotos">
    
    <% photos.forEach( photo => { %>
      
      <div class="galleryimage">

        <figure>

          <img id="galleryphoto" src="img/uploads/gallerypage/<%= photo.galleryimage %>" alt="<%= photo.galleryimagecaption %>" width="320" height="299" />
          <figcaption>

            <div> <%= photo.galleryimagecaption %> </div>

            <div class="projectDate"> Uploaded: <span class="datecreated"> <%= photo.createdAt.toLocaleString() %> </span> </div>
            
            <div class="adminupdatedeletebuttons">
              <a href="/updategallerypage/<%= photo._id %>"> <button class="updategalleryphoto"> Update Photo </button> </a>
              <a href="/deletegalleryimage/<%= photo._id %>"> <button class="deletegalleryphoto"> Delete Photo </button> </a>
            </div>

          </figcaption>

        </figure>

      </div>
        
    <% } ); %>

  </div>

</section>