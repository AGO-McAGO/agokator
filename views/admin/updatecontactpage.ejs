<section class="up">
  
  <div class="goback"> <a href="/dashboard">&larr; Back </a> </div>

  <div> <h2> Upadte Contact Information </h2> </div>

  <div class="adminformdiv">

    <form action="/updatecontactpage/<%= contacts._id %>?_method=PUT" enctype="multipart/form-data"  method="POST">

      <div>
        <label for="address"> <b> Address </b> </label>
        <input type="text" name="homeaddress" value="<%= contacts.homeaddress %>" id="homeaddress" class="admininput"  placeholder="Home Address ...." />
      </div>

      <div>
        <label for="emailaddress"> <b> Email Address </b> </label>
        <input type="text" name="emailaddress" value="<%= contacts.emailaddress %>" id="emailaddress" class="admininput"  placeholder="Email Address ...." />
      </div>

      <div>
        <label for="phonenumber"> <b> Phone number </b> </label>
        <input type="text" name="phonenumber" value="<%= contacts.phonenumber %>" id="phonenumber" class="admininput"  placeholder="Phone number ...." />
      </div>
      
      <div> <input type="submit" name="submit" value="Update Contact Information" id="submit" /> </div>
  
    </form>

  </div>

</section>