<section class="up">
  
  <div class="goback"> <a href="/dashboard">&larr; Back</a> </div>

  <div> <h2> Add Contact Information </h2> </div>

  <div>

    <form action="/addcontactpage" enctype="multipart/form-data"  method="POST">

      <div>
        <label for="address"> <b> Address </b> </label>
        <input type="text" name="homeaddress" id="homeaddress"  placeholder="Home Address ...." />
      </div>

      <div>
        <label for="emailaddress"> <b> Email Address </b> </label>
        <input type="text" name="emailaddress" id="emailaddress"  placeholder="Email Address ...." />
      </div>

      <div>
        <label for="phonenumber"> <b> Phone number </b> </label>
        <input type="text" name="phonenumber" id="phonenumber"  placeholder="Phone number ...." />
      </div>
      
      <div> <input type="submit" name="submit" value="Add Information" id="submit" /> </div>
  
    </form>
  </div>

</section>